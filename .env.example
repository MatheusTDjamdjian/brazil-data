# ============================================================
# Brazil Data — Assistente Contábil
# ============================================================
# Tudo aqui é OPCIONAL. Os defaults batem com o docker-compose.yml.
# O projeto NÃO usa LLM externo — agente 100% determinístico.

# Banco e cache (defaults conectam ao docker-compose)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mcp_contabil
# REDIS_URL=redis://localhost:6379

# Portas dos serviços
# API_PORT=3001
# WEB_PORT=3000

# Histórico (quantos turnos manter por conversa)
# HISTORY_MAX_TURNS=6

# Cache de resposta final (Redis)
# ENABLE_RESPONSE_CACHE=true
# RESPONSE_CACHE_TTL_SECONDS=3600

# Observabilidade
# LOG_LEVEL=info
