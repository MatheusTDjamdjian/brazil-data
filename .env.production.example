# ============================================================
# Variáveis para deploy em produção — Opção A (Vercel + Render)
# ============================================================
# Não suba este arquivo preenchido. Use só como referência;
# os valores reais vão nos painéis da Render (API) e Vercel (Web).

# ----- API (configure no painel da Render) -----

# Postgres gerenciado — https://neon.tech (free 256 MB)
# Cole a "Connection string" do projeto Neon (já vem com sslmode=require).
DATABASE_URL=postgresql://user:pass@ep-xyz.us-east-2.aws.neon.tech/brazil_data?sslmode=require

# Redis gerenciado — https://upstash.com (free 10k cmd/dia)
# Use a URL "rediss://" (TLS). O ioredis aceita direto.
REDIS_URL=rediss://default:senha@us1-xyz.upstash.io:6379

# A Render injeta $PORT automaticamente e o startCommand do render.yaml
# faz API_PORT=$PORT. Não precisa setar API_PORT manualmente.
NODE_ENV=production
LOG_LEVEL=info

# ----- Web (configure no painel da Vercel) -----

# URL pública da API depois que ela subir na Render.
NEXT_PUBLIC_API_BASE=https://brazil-data-api.onrender.com
