generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@index([userId, createdAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String // 'user' | 'assistant' | 'tool'
  content        String   @db.Text
  toolCalls      Json?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model EmpresaCache {
  cnpj         String   @id
  dadosJson    Json
  atualizadoEm DateTime @default(now()) @updatedAt
}

// RequestMetric: 1 linha por request a /chat. Permite o dashboard
// /admin/metrics responder sobre latência média, % de cache hit,
// distribuição por intent e perguntas não-reconhecidas.
//
// Substituiu o antigo modelo LlmCall — projeto pivotou para zero-LLM,
// não há tokens/custo a medir, apenas performance e cobertura de intent.
model RequestMetric {
  id             String   @id @default(cuid())
  conversationId String?
  intent         String // intent.type
  toolName       String? // null para help/unknown
  matchedBy      String? // intent.matchedBy (debug)
  isError        Boolean  @default(false)
  cached         Boolean  @default(false)
  durationMs     Int // total
  toolDurationMs Int? // só a chamada da tool (null se cached ou sem tool)
  userMessage    String   @db.Text // mensagem original do usuário
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([intent, createdAt])
  @@index([cached, createdAt])
}
